@model SignUpDto
@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg border-0 rounded-4 p-4 auth-card w-100" style="max-width: 500px;">
        <div class="auth-header text-center mb-4">
            <i class="fa-solid fa-user-plus fa-3x text-success mb-3"></i>
            <h3 class="fw-bold text-dark">Create Your Account</h3>
            <p class="text-muted mb-0">Join us and start managing your library today!</p>
        </div>

        <form asp-action="SignUp" class="mt-3">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="UserName" class="form-control form-control-sm" placeholder="User Name" />
                <label asp-for="UserName"></label>
                <span class="text-danger" asp-validation-for="UserName"></span>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-floating mb-3">
                        <input asp-for="FirstName" class="form-control form-control-sm" placeholder="First Name" />
                        <label asp-for="FirstName"></label>
                        <span class="text-danger" asp-validation-for="FirstName"></span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-floating mb-3">
                        <input asp-for="LastName" class="form-control form-control-sm" placeholder="Last Name" />
                        <label asp-for="LastName"></label>
                        <span class="text-danger" asp-validation-for="LastName"></span>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control form-control-sm" placeholder="Email address" />
                <label asp-for="Email"></label>
                <span class="text-danger" asp-validation-for="Email"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" type="password" class="form-control form-control-sm" placeholder="Password" />
                <label asp-for="Password"></label>
                <span class="text-danger" asp-validation-for="Password"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-sm" placeholder="Confirm Password" />
                <label asp-for="ConfirmPassword"></label>
                <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsAgree" class="form-check-input" required />
                <label asp-for="IsAgree" class="form-check-label">
                    I agree to the <a href="#" class="text-success text-decoration-none">terms & conditions</a>
                </label>
                <span class="text-danger" asp-validation-for="IsAgree"></span>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-success btn-lg shadow-sm">
                    <i class="fa-solid fa-user-check me-2"></i> Sign Up
                </button>
            </div>

            <div class="auth-footer text-center mt-3">
                <small>
                    Already have an account?
                    <a asp-action="SignIn" asp-controller="Account" class="text-success text-decoration-none fw-semibold">
                        Sign In
                    </a>
                </small>
            </div>
        </form>
    </div>
</div>

@section Validation {
    <partial name="_ValidationScriptsPartial" />
}


