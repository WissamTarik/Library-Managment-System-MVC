@model SignInDto
@{
    ViewData["Title"] = "SignIn";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    string Message = TempData["Message"] as string;
}

<div class="auth-header">
    <i class="fa-solid fa-right-to-bracket"></i>
    <h3>Welcome Back</h3>
</div>

<form asp-action="SignIn" >
    <div asp-validation-summary="All"></div>
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert alert-dismissible alert-success">
            <p>@Message</p>
            <button class="btn btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <div class="form-floating mb-3">
        <input asp-for="Email" class="form-control" placeholder="Email address" />
        <label asp-for="Email">Email</label>
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
        <label asp-for="Password">Password</label>
        <span class="text-danger" asp-validation-for="Password"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
        <label asp-for="RememberMe" class="form-check-label">Remember me</label>
    </div>

    <div class="d-grid mb-2">
        <button type="submit" class="btn btn-success btn-lg">
            <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
        </button>
    </div>

    <div class="auth-footer">
        <a asp-action="ForgetPassword"  class="text-success text-decoration-none">
            Forgot Password?
        </a>
        <br />
        Don't have an account?
        <a asp-action="SignUp" asp-controller="Account" class="text-success text-decoration-none">
            Sign Up
        </a>
    </div>
</form>

@section Validation {
    <partial name="_ValidationScriptsPartial" />
}

