@model ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow-lg p-4 border-0 rounded-4" style="max-width: 420px; width: 100%;">
        <div class="auth-header text-center mb-4">
            <i class="fa-solid fa-lock text-success mb-3" style="font-size: 3rem;"></i>
            <h3 class="fw-bold">Reset Your Password</h3>
            <p class="text-muted small mb-0">Please enter your new password below.</p>
        </div>

        <form asp-action="ResetPassword" >
            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

            <div class="form-floating mb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="New Password" />
                <label asp-for="Password">New Password</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid mb-3">
                <button type="submit" class="btn btn-success btn-lg shadow-sm">
                    <i class="fa-solid fa-rotate-right me-2"></i> Update Password
                </button>
            </div>

            <div class="text-center">
                <a asp-action="SignIn" asp-controller="Account" class="text-success text-decoration-none small">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Back to Sign In
                </a>
            </div>
        </form>
    </div>
</div>

@section Validation {
    <partial name="_ValidationScriptsPartial" />
}
