@model ForgetPasswordDto
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-header">
    <i class="fa-solid fa-unlock-keyhole"></i>
    <h3>Forgot Your Password?</h3>
</div>

<form asp-action="SendResetPasswordUrl">
    <div asp-validation-summary="All"></div>

    <div class="form-floating mb-3">
        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
        <label asp-for="Email">Email</label>
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>

    <div class="d-grid mb-2">
        <button type="submit" class="btn btn-success btn-lg">
            <i class="fa-solid fa-paper-plane me-1"></i> Send Reset Link
        </button>
    </div>

    <div class="auth-footer">
        <a asp-action="SignIn" asp-controller="Account" class="text-success text-decoration-none">
            Back to Sign In
        </a>
    </div>
</form>

