@model IEnumerable<Author>
@{
    ViewData["Title"] = "Index";
}

<div class="container my-5">
    <!-- Page Header -->
    <div class="text-center mb-4">
        <h1 class="fw-bold text-dark">
            <i class="fas fa-users-line me-2 text-success"></i>Authors
        </h1>
    </div>

    <!-- Search and Add Section -->
    <div class="row mb-3 align-items-center g-2">
        <!-- Search -->
        <div class="col-12 col-md-8">
            <form asp-action="Index" class="d-flex">
                <div class="input-group w-75">
                    <input type="search" name="SearchInput" class="form-control" placeholder="Search by name..." />
                    <button class="btn btn-secondary" type="submit">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>
            </form>
        </div>

        <!-- Add button -->
        <div class="col-12 col-md-4 text-start text-md-end">
            <a class="btn btn-primary w-75 w-md-auto" asp-action="Create">
                <i class="fas fa-plus me-1"></i> Add new Author
            </a>
        </div>
    </div>


    <!-- Alert Message -->
    @if (!string.IsNullOrEmpty(TempData["Message"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Section -->
    @if (Model.Any())
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-dark table-striped table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Author Image</th>
                        <th>Author Name</th>
                        <th>BIO</th>
                        <th>DOB</th>
                        <th>Details</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="~/files/images/@item.ImageName"
                                     alt="@item.Name"
                                     class="rounded-circle border border-2 border-secondary"
                                     style="width: 70px; height: 70px; object-fit: cover;" />
                            </td>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="text-truncate" style="max-width: 200px;">@item.Bio</td>
                            <td>@item.DOB.ToString("dd MMM yyyy")</td>
                            <partial name="PartialBtnView" model="@item.Id.ToString()" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 text-center py-5 mt-4">
            <div class="card-body">
                <i class="fas fa-user-slash text-primary mb-3" style="font-size: 3rem;"></i>
                <p class="text-muted mb-3 fs-6">No Authors Available</p>
                <a class="btn btn-primary text-capitalize w-50 mx-auto d-flex align-items-center justify-content-center gap-2" asp-action="Create">
                    <i class="fas fa-plus"></i> Add New Author
                </a>
            </div>
        </div>
    }
</div>
