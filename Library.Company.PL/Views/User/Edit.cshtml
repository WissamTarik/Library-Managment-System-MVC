@model UserToReturnDto
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center">
                    <h4> Edit user @Model.UserName</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div class="mb-3 form-floating">
                            <input class="form-control" asp-for="Id" placeholder="Id"  readonly />
                            <label asp-for="Id"></label>
                        </div>

                        <div class="mb-3 form-floating">
                            <input class="form-control" asp-for="UserName" placeholder="UserName"  />
                            <label asp-for="UserName"></label>
                        </div>

                        <div class="mb-3 form-floating">
                            <input class="form-control" asp-for="FirstName" placeholder="First Name"  />
                            <label asp-for="FirstName"></label>
                        </div>
                        <div class="mb-3 form-floating">
                            <input class="form-control" asp-for="LastName" placeholder="Last Name"  />
                            <label asp-for="LastName"></label>
                        </div>
                        <div class="mb-3 form-floating">
                            <input class="form-control" asp-for="Email" placeholder="Email"  />
                            <label asp-for="Email"></label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success" asp-action="Edit">
                                <i class="fas fa-save me-3"></i> Save
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary mt-2">Return to users List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Validation {
    <partial name="_ValidationScriptsPartial" />
}


