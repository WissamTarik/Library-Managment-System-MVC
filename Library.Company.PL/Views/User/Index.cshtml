@model IEnumerable<UserToReturnDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <!-- Page Header -->
    <div class="text-center mb-4">
        <h1 class="fw-bold">
            <i class="fas fa-users me-2 text-success"></i>Users
        </h1>
    </div>

    <!-- Search Section -->
    <div class="row justify-content-center mb-4">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <form asp-action="Index" class="d-flex">
                <div class="input-group">
                    <input type="search" name="SearchInput" class="form-control" placeholder="Search by name..." />
                    <button class="btn btn-secondary" type="submit">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Alert Message -->
    @if (!string.IsNullOrEmpty(TempData["Message"] as string))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Section -->
    @if (Model.Any())
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table table-dark table-striped table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(d => d.Id)</th>
                        <th>Username</th>
                        <th>@Html.DisplayNameFor(d => d.FirstName)</th>
                        <th>@Html.DisplayNameFor(d => d.LastName)</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Details</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.UserName</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Email</td>
                            <td>
                                @foreach (var role in item.Roles)
                                {
                                    <span class="badge bg-warning text-dark">@role</span>
                                }
                            </td>
                            <partial name="PartialBtnView" model="@item.Id" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 text-center py-5">
            <div class="card-body">
                <i class="fas fa-user text-primary mb-3" style="font-size: 3rem;"></i>
                <p class="text-muted mb-3 fs-6">No users available</p>
            </div>
        </div>
    }
</div>

