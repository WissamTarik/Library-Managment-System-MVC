@model Book
@{
    ViewData["Title"] = "Details";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-book-open me-2"></i>Book Details
                    </h4>
                </div>

                <div class="card-body p-4">
                    <div class="mb-3 form-floating">
                        <input class="form-control" asp-for="ISBN" placeholder="ISBN" readonly />
                        <label asp-for="ISBN"></label>
                    </div>

                    <div class="mb-3 form-floating">
                        <input class="form-control" asp-for="Title" placeholder="Title" readonly />
                        <label asp-for="Title"></label>
                    </div>

                    <div class="mb-3 form-floating">
                        <input class="form-control" asp-for="PublishedYear" placeholder="Published Year" readonly />
                        <label asp-for="PublishedYear"></label>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-pen-alt me-2"></i>Edit
                        </a>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Return to Book List
                            <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

