@model BookDto
@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center">
                    <h4> Edit Book @Model.Title</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <partial name="BookPartialViews/CreateAndEditPartialView" />

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success" asp-action="Edit">
                                <i class="fas fa-save me-3"></i> Save
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary mt-2">Return to Book List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Validation {
    <partial name="_ValidationScriptsPartial" />
}
