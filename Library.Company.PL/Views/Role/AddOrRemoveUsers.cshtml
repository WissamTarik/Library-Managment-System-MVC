@model List<UserInRoleDto>
@{
    ViewData["Title"] = "AddOrRemoveUsers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roleId = ViewData["roleId"] as string;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-users-cog me-2"></i>Manage Users in Role
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="AddOrRemoveUsers"  asp-route-roleId="@roleId">
                        <div class="list-group mb-4">
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <div class="list-group-item d-flex align-items-center justify-content-between">
                                    <div class="form-check">
                                        <input asp-for="@Model[i].IsSelected" class="form-check-input" />
                                        <label asp-for="@Model[i].IsSelected" class="form-check-label fw-semibold">
                                            @Model[i].UserName
                                        </label>
                                    </div>
                                    <input asp-for="@Model[i].Id" hidden/>
                                    <input asp-for="@Model[i].UserName" hidden/>

                                   
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>Update
                            </button>

                            <a asp-action="Edit"  class="btn btn-outline-secondary" asp-route-id="@roleId">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
